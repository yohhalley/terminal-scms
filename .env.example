COMPOSE_PROJECT_NAME=terminal-scms

MINITOS_CONTEXT=./apps/minitos
OES_CONTEXT=./apps/terminal-oes
GODOT_CONTEXT=./clients/godot-open-terminal

MINITOS_DB_NAME=minitos
MINITOS_DB_USER=minitos
MINITOS_DB_PASSWORD=change-me-minitos-db
MINITOS_SECRET_KEY=change-me-minitos-secret

OES_DB_NAME=terminal_oes
OES_DB_USER=terminal_oes
OES_DB_PASSWORD=change-me-oes-db
OES_SECRET_KEY=change-me-oes-secret
OES_API_TOKEN=change-me-oes-api-token
SIMULATOR_RUNNER_TOKEN=change-me-runner-token
SIMULATOR_OES_URL=http://terminal-oes:8000
SPARKPLUG_HOST_ID=TERMINAL-OES
MES_API_TOKEN=change-me-mes-api-token

# The Linux host's LAN address is added to both ALLOWED_HOSTS lists below.
# Set it in your local .env (gitignored), without angle brackets, e.g.
# SCMS_SERVER_HOST=<your-server-ip>
MINITOS_ALLOWED_HOSTS=localhost,127.0.0.1,minitos
OES_ALLOWED_HOSTS=localhost,127.0.0.1,terminal-oes

GODOT_VERSION=4.2.1
GODOT_PLATFORM=linux/amd64
SIMULATOR_DEFAULT_SPEED_MPS=4.0
SIMULATOR_IMAGE=terminal-scms/godot-simulator:local
SIMULATOR_DOCKER_NETWORK=terminal-scms
RUNNER_IDENTITY=local-runner

MQTT_PORT=1883
HIVEMQ_JMX_ENABLED=false
MINITOS_HTTP_PORT=8000
OES_HTTP_PORT=8010
