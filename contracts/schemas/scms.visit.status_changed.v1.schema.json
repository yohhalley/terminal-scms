{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yohhalley/terminal-scms/contracts/schemas/scms.visit.status_changed.v1.schema.json",
  "title": "scms.visit.status_changed.v1 (MiniTOS -> UNS visit milestone event)",
  "description": "TCL-003b, S2 slice of D-026 (milestones on the UNS) with the D-024 timestamps. One event per saved status change of a carrier visit (vessel/barge/truck/train) or a container visit, including the first status at creation (from_status null). Topics: scms/v2/{enterprise}/{site}/tos/carrier-visits/{entity_id}/status-changed and scms/v2/{enterprise}/{site}/tos/container-visits/{entity_id}/status-changed; QoS 1, not retained; the lowercase-kebab segments are intentional and match the enterprise/site codes. Same-transaction outbox (docs/ARCHITECTURE.md, as scms.order.released.v1): the outbox row is written in the transaction that saves the status, so a rolled-back change is never published and a committed change keeps its event; a same-status save publishes nothing. Envelope per architecture synchronization rule 7: schema (name and version, as every SCMS event), event_id, occurred_at (MiniTOS wall clock, ISO 8601 with offset, when the change was saved), Enterprise/Site/terminal scope, aggregate {type, id, revision}, correlation_id, causation_id. aggregate.type/id equal data.entity_type/entity_id; aggregate.revision is the visit's status_revision counter, +1 per event of that visit (1 = creation), strictly increasing per aggregate. causation_id is the triggering message id (the OES execution event_id) or null; correlation_id is the inherited conversation id (the OES message's correlation_id, else its event_id; the HTTP X-Correlation-ID header), else equal to this event's event_id. Both sit at the top level, as in scms.execution.event.v1. occurred_at stays wall-clock time, as in every MiniTOS envelope: it is when MiniTOS committed the fact (historian and outbox order rely on it), MiniTOS has no simulation clock, and most changes (API, admin, scenario seed) have no sim time. data.sim_time_ms carries the simulation time in ms alongside it when the change was caused by an OES execution event carrying source_sim_time_ms; it is null otherwise (no OES cause, or OES did not send it, which is the case today). QA M2: reset_epoch is the optional top-level run marker stamped by the same helper as the other MiniTOS envelopes (reset_epoch.stamp) while a scenario-reset epoch is stored; absent otherwise. data.source says which path made the change. data.carrier_visit or data.container_visit (matching entity_type) carries the entity details; for container visits these are the D-010 fields (ISO 6346 container_number, category, ib_carrier, ob_carrier). to_status/from_status are the MiniTOS status values; industry milestone names (spec Q14) are not mapped yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "occurred_at",
    "enterprise",
    "site",
    "terminal",
    "aggregate",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "scms.visit.status_changed.v1"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "reset_epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "description": "QA M2 scenario-reset run generation marker (optional; see description)."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "enterprise": {
      "type": "object",
      "required": [
        "id",
        "code"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "site": {
      "type": "object",
      "required": [
        "id",
        "code",
        "source_location_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source_location_id": {
          "type": "integer"
        }
      }
    },
    "terminal": {
      "type": "object",
      "required": [
        "id",
        "code"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "code": {
          "type": "string"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "revision"
      ],
      "properties": {
        "type": {
          "enum": [
            "carrier_visit",
            "container_visit"
          ]
        },
        "id": {
          "type": "integer"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type",
        "entity_id",
        "entity_code",
        "from_status",
        "to_status",
        "sim_time_ms",
        "source"
      ],
      "properties": {
        "entity_type": {
          "enum": [
            "carrier_visit",
            "container_visit"
          ]
        },
        "entity_id": {
          "type": "integer"
        },
        "entity_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "to_status": {
          "type": "string"
        },
        "sim_time_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "enum": [
            "minitos.api",
            "minitos.admin",
            "minitos.scenario",
            "minitos.system",
            "oes.execution"
          ]
        },
        "carrier_visit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visit_type",
            "vessel_name"
          ],
          "properties": {
            "visit_type": {
              "enum": [
                "Vessel",
                "Barge",
                "Truck",
                "Train"
              ]
            },
            "vessel_name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "container_visit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "container_number",
            "category",
            "ib_carrier",
            "ob_carrier"
          ],
          "properties": {
            "container_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "category": {
              "enum": [
                "I",
                "E",
                "T",
                "S",
                "O",
                "M"
              ]
            },
            "ib_carrier": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "visit_type"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "visit_type": {
                  "enum": [
                    "Vessel",
                    "Barge",
                    "Truck",
                    "Train"
                  ]
                }
              }
            },
            "ob_carrier": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "visit_type"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "visit_type": {
                  "enum": [
                    "Vessel",
                    "Barge",
                    "Truck",
                    "Train"
                  ]
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "entity_type": {
                "const": "carrier_visit"
              }
            }
          },
          "then": {
            "required": [
              "carrier_visit"
            ],
            "properties": {
              "entity_code": {
                "type": "string"
              },
              "to_status": {
                "enum": [
                  "Created",
                  "Announced",
                  "Arrived",
                  "InOperation",
                  "Complete",
                  "Departed"
                ]
              },
              "from_status": {
                "enum": [
                  "Created",
                  "Announced",
                  "Arrived",
                  "InOperation",
                  "Complete",
                  "Departed",
                  null
                ]
              }
            },
            "not": {
              "required": [
                "container_visit"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity_type": {
                "const": "container_visit"
              }
            }
          },
          "then": {
            "required": [
              "container_visit"
            ],
            "properties": {
              "to_status": {
                "enum": [
                  "Preadvised",
                  "Arrived",
                  "AtYard",
                  "AtQC",
                  "OnEquipment",
                  "OnVessel",
                  "Departed",
                  "Completed"
                ]
              },
              "from_status": {
                "enum": [
                  "Preadvised",
                  "Arrived",
                  "AtYard",
                  "AtQC",
                  "OnEquipment",
                  "OnVessel",
                  "Departed",
                  "Completed",
                  null
                ]
              }
            },
            "not": {
              "required": [
                "carrier_visit"
              ]
            }
          }
        }
      ]
    }
  }
}
