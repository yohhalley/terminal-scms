# Environment variables for MiniTOS
# Copy this file to .env and fill in your values for local development

# Django settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database settings (for production/Heroku)
# DATABASE_URL will be automatically set by Heroku
# For local development, SQLite is used by default

# Heroku deployment notes:
# Set these environment variables in Heroku dashboard:
# - SECRET_KEY: Generate a new secret key for production
# - DEBUG: False
# - ALLOWED_HOSTS: your-app-name.herokuapp.com
# - DATABASE_URL: Automatically set by Heroku Postgres add-on