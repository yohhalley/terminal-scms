# Environment variables for MiniTOS
# Copy this file to .env and fill in your values for local development

# Django settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL settings used by Docker and ordinary local deployments
DB_NAME=minitos
DB_USER=minitos
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Service integration
MES_API_TOKEN=change-me
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=minitos
MQTT_TLS=False
UNS_ROOT=scms/v1
USE_WHITENOISE=True

# Heroku deployment notes:
# Set these environment variables in Heroku dashboard:
# - SECRET_KEY: Generate a new secret key for production
# - DEBUG: False
# - ALLOWED_HOSTS: your-app-name.herokuapp.com
# - DATABASE_URL: Automatically set by Heroku Postgres add-on
